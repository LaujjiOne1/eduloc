@startuml 01_cas_utilisation
title Diagramme de cas d'utilisation global d'EduLoc
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam shadowing false
skinparam nodesep 14
skinparam ranksep 20

' Mise en page : une seule figure en portrait (page A4, 2 cm de marge). Acteurs répartis de part et d'autre : le demandeur
' et le partenaire à gauche, le tuteur et l'administrateur à droite ; « S'authentifier » et « Changer de mode » sont au centre,
' à égale distance des quatre acteurs. Le sens de chaque liaison suit la grille et les liens invisibles ([hidden])
' maintiennent l'alignement. L'acteur « Services externes » est dessiné deux fois, près des cas qu'il sert.

actor "Demandeur" as DEM
actor "Tuteur" as TUT
actor "Partenaire de lieu\n(Gestionnaire)" as PAR
actor "Administrateur" as ADM
actor "Services externes\n(Ollama, PaddleOCR)" as EXI <<système>>
actor "Services externes\n(LiveKit, Centrifugo,\nPush, e-mail)" as EXC <<système>>

rectangle "EduLoc" {

  package "Recherche et mise en relation" {
    usecase "Consulter les lieux\nd'étude à proximité" as UC13
    usecase "Consulter le profil\net les offres d'un tuteur" as UC12
    usecase "Rechercher un tuteur\n(niveau, filière, matière)" as UC10
    usecase "Appliquer le matching\nsémantique hybride" as UC11
  }

  package "Réservation et séance" {
    usecase "Soumettre une demande\nde réservation" as UC31
    usecase "Obtenir un devis\n(blocage du créneau 15 min)" as UC30
    usecase "Vérifier les conflits" as UC33
    usecase "Accepter ou refuser\nune demande" as UC32
    usecase "Suivre ses réservations" as UC37
    usecase "Annuler une réservation" as UC34
    usecase "Terminer la séance" as UC36
    usecase "Démarrer la séance\n(code à usage unique)" as UC35
  }

  package "Profil et offres du tuteur" {
    usecase "Gérer ses offres" as UC22
    usecase "Gérer ses disponibilités\net ses lieux" as UC23
    usecase "Importer son CV" as UC21
    usecase "Accepter une salle partenaire" as UC24
    usecase "Soumettre sa candidature\n(documents justificatifs)" as UC20
  }

  package "Communication et avis" {
    usecase "Évaluer un tuteur" as UC53
    usecase "Évaluer une salle" as UC54
    usecase "Échanger des messages vocaux" as UC50
    usecase "Répondre à un avis" as UC55
    usecase "Passer un appel audio / vidéo" as UC51
    usecase "Recevoir des notifications" as UC52
  }

  package "Comptes et bénéficiaires" {
    usecase "Gérer ses bénéficiaires" as UC03
    usecase "Changer de mode\n(demandeur / tuteur / partenaire)" as UC04
    usecase "S'inscrire et vérifier\nson adresse e-mail" as UC01
    usecase "S'authentifier" as UC02
  }

  package "Lieux partenaires" {
    usecase "Gérer ses salles\n(horaires, fermetures, photos)" as UC41
    usecase "Consulter les réservations\nde ses salles" as UC43
    usecase "Choisir une offre commerciale" as UC42
    usecase "Déclarer sa structure\net ses justificatifs" as UC40
  }

  package "Administration" {
    usecase "Contrôler un justificatif\n(l'ouvrir, attester de son\nauthenticité)" as UC61
    usecase "Traiter les conflits\nde réservation\n(résoudre / classer)" as UC66
    usecase "Consulter le tableau de bord\n(ce qui attend une décision)" as UC60
    usecase "Modérer les avis\nsur les salles" as UC72
    usecase "Réindexer la recherche\nsémantique" as UC69
    usecase "Consulter les réservations" as UC68
    usecase "Gérer les offres commerciales\n(plans, abonnements)" as UC71
    usecase "Suspendre ou rétablir\nun tuteur" as UC64
    usecase "Valider ou refuser une\ncandidature de tuteur" as UC62
    usecase "Gérer les comptes utilisateurs\n(suspendre / réactiver)" as UC67
    usecase "Valider une structure\net ses salles" as UC70
    usecase "Valider le niveau académique\net les équivalences de diplôme" as UC63
    usecase "Modérer les offres de cours\n(retirer / rétablir)" as UC65
  }

}

