# --- Application ---
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000
CORS_ORIGINS=https://app.eduloc.mg,http://localhost:3000,http://localhost:3001

# --- PostgreSQL (PostGIS) ---
# Application : pooler transactionnel en prod ; en local : connexion directe.
DATABASE_URL=postgresql://eduloc:eduloc@localhost:5432/eduloc?schema=public
# Migrations : connexion directe (équivalent Supabase DIRECT_URL).
DIRECT_URL=postgresql://eduloc:eduloc@localhost:5432/eduloc?schema=public

# --- pgAdmin (interface d'administration locale) ---
PGADMIN_DEFAULT_EMAIL=admin@eduloc.com
PGADMIN_DEFAULT_PASSWORD=admin

# --- Redis (cache, rate limit, idempotence, métadonnées d'upload) ---
REDIS_URL=redis://localhost:6379

# --- JWT (accès 15 min) ---
JWT_SECRET=change-me-32-bytes-minimum-secret-key!!
JWT_EXPIRES_IN=15m

# --- Chiffrement OTP (AES-256-GCM, 32 bytes en hex) ---
OTP_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff

# --- Supabase (service_role uniquement, jamais exposé au client) ---
SUPABASE_URL=https://votre-projet.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service-role-key
SUPABASE_VOICE_BUCKET=voice-messages
SUPABASE_DOCUMENTS_BUCKET=documents
SUPABASE_TUTOR_DOCS_BUCKET=tutor-documents
SUPABASE_PARTNER_DOCS_BUCKET=partner-documents
SUPABASE_ROOM_PHOTOS_BUCKET=room-photos

# --- Centrifugo ---
CENTRIFUGO_URL=http://localhost:8000
CENTRIFUGO_API_KEY=centrifugo-api-key
CENTRIFUGO_TOKEN_SECRET=centrifugo-connection-secret
CENTRIFUGO_SUB_SECRET=centrifugo-subscription-secret

# --- LiveKit (remplace Stream Video — décision attachment) ---
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secretsecretsecretsecretsecretsecret

# --- FCM / APNs (push hors application) : JSON encodé, optionnel ---
FCM_SERVICE_ACCOUNT_JSON=
# --- Push via Expo (jetons ExponentPushToken[...], iOS + Android) : jeton d'accès optionnel ---
EXPO_ACCESS_TOKEN=
RESEND_API_KEY=
MAIL_FROM=onboarding@resend.dev
# Vous pouvez aussi utiliser un nom d'expéditeur : EduLoc <noreply@votre-domaine.com>

# --- Règles métier (attachment) ---
BOOKING_MIN_NOTICE_HOURS=24
# Pas de démarrage et marges (minutes) — valeurs à confirmer avec le responsable produit
BOOKING_SLOT_STEP_MINUTES=30
BOOKING_BUFFER_MINUTES=15
BOOKING_TRAVEL_BUFFER_MINUTES=30
ROOM_TURNOVER_BUFFER_MINUTES=0
# Frais de service EduLoc (taux sur le tarif du Tuteur), blocage temporaire du créneau, plafond horaire d'une salle (Ar)
PLATFORM_COMMISSION_RATE=0.10
BOOKING_HOLD_MINUTES=15
ROOM_MAX_HOURLY_FEE=10000
CANCELLATION_FREE_NOTICE_HOURS=24
MEDIA_RETENTION_MONTHS=12

# --- Embeddings du matching sémantique (Ollama, réseau privé uniquement) ---
# En Docker Compose, OLLAMA_URL est fixé à http://ollama:11434 (cf. docker-compose.yml).
OLLAMA_URL=http://localhost:11434
# Version épinglée de l'image ollama/ollama (jamais latest) : doit supporter le modèle ci-dessous.
# 0.40.3 ne charge pas embeddinggemma-2 ; 0.40.4 (rc1 pour l'instant) oui.
OLLAMA_VERSION=0.40.4-rc1
# embeddinggemma-2 (spec) exige le moteur MLX d'Apple Silicon : indisponible sous Docker Linux/CPU (Ollama 0.40.x).
# EmbeddingGemma 1 (300m, 768 dim, mêmes préfixes) le remplace tant que ce n'est pas levé ; changer de modèle impose de réindexer.
# EMBEDDING_MODEL=embeddinggemma:300m   # ancien modèle (EmbeddingGemma 1)
EMBEDDING_MODEL=hf.co/unsloth/embeddinggemma-2-GGUF:UD-Q4_K_XL
EMBEDDING_DIM=768

# --- Scoring du matching (spec §6.4) : valeurs initiales, à calibrer avec le jeu d'évaluation ---
MATCHING_CORROBORATION_WEIGHT=0.02
MATCHING_CORROBORATION_WINDOW=0.1
MATCHING_SUBJECT_BONUS=0.03
MATCHING_RATING_BONUS=0.02
MATCHING_RATING_PRIOR_MEAN=3.5
MATCHING_RATING_PRIOR_WEIGHT=5
MATCHING_RELEVANCE_WINDOW=0.15
# Plancher absolu de similarité (propre au modèle d'embedding, calibré sur eval/report.md : pertinents >= 0.654)
MATCHING_MIN_SIMILARITY=0.65
# Classement final après le tri sémantique (la distance n'entre jamais dans le modèle sémantique)
MATCHING_WEIGHT_PEDAGOGY=0.6
MATCHING_WEIGHT_AVAILABILITY=0.2
MATCHING_WEIGHT_PROXIMITY=0.1
MATCHING_WEIGHT_QUALITY=0.1

# Import de CV (pré-remplissage du dossier tuteur) : OCR PaddleOCR + extraction structurée par un LLM Ollama.
# PADDLEOCR_URL absent : l'OCR retombe sur Tesseract. En Docker Compose : http://paddleocr:5000.
PADDLEOCR_URL=http://localhost:5002
# Modèle de GÉNÉRATION (distinct des embeddings) : docker exec eduloc-ollama ollama pull qwen2.5:3b
CV_EXTRACTION_MODEL=qwen2.5:3b
CV_EXTRACTION_TIMEOUT_MS=600000

# IP du PC que les clients (navigateur, téléphone) utilisent pour joindre LiveKit (appels). 127.0.0.1 : PC seul ; IP LAN : téléphone.
LIVEKIT_NODE_IP=127.0.0.1
