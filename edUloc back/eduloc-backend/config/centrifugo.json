{
  "client": {
    "allowed_origins": [
      "https://app.eduloc.mg",
      "https://eduloc.mg",
      "http://localhost:*",
      "http://127.0.0.1:*",
      "http://192.168.*:*",
      "http://10.*:*"
    ]
  },
  "channel": {
    "namespaces": [
      {
        "name": "personal",
        "allow_user_limited_channels": true,
        "history_size": 100,
        "history_ttl": "72h",
        "force_recovery": true
      },
      {
        "name": "conv",
        "allow_publish_for_subscriber": true,
        "presence": true
      },
      {
        "name": "slots",
        "allow_subscribe_for_client": true
      }
    ]
  }
}
