{
  "name": "eduloc-backend",
  "version": "2.0.0",
  "description": "EduLoc V2 - API marketplace de tutorat géolocalisé (NestJS / Prisma / PostgreSQL+PostGIS)",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "node --import tsx --test \"test/unit/**/*.spec.ts\"",
    "test:int": "node --import tsx --test --test-concurrency=1 \"test/integration/**/*.int.spec.ts\"",
    "db:seed": "tsx prisma/seed.ts",
    "try:matching": "node scripts/try-matching.mjs",
    "db:seed:matching": "tsx prisma/seed-matching.ts",
    "matching:eval": "tsx eval/run.ts",
    "matching:reindex-all": "node dist/modules/matching/cli/reindex-all.command.js",
    "db:deploy": "prisma migrate deploy",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^8.1.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.10.0",
    "@supabase/supabase-js": "^2.47.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "firebase-admin": "^13.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "livekit-server-sdk": "^2.8.0",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^3.11.174",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.6.1",
    "prisma": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2"
  }
}
