// ============================================================
// EduLoc V2 — schema.prisma (Prisma 7)
// ------------------------------------------------------------
// Contraintes non exprimables en Prisma (exclusion anti-chevauchement,
// CHECK, PostGIS, index partiels) : prisma/sql/001_constraints.sql
// à coller dans la première migration créée avec --create-only.
// ============================================================

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING_VERIFICATION
}

enum TutorApplicationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
}

enum TutorDocumentType {
  IDENTITY
  DIPLOMA
  CERTIFICATE
  PROFESSIONAL_PROOF
  CV
  /// Relevé de notes : la liste réelle des cours suivis est un indice fort.
  TRANSCRIPT
  /// Certificat de scolarité : preuve du niveau en cours d'un tuteur qui prépare encore son diplôme.
  ENROLLMENT_CERTIFICATE
  OTHER
}

enum SearchChunkSource {
  PROFILE
  SUBJECT
  EXPERIENCE
  OFFER
  DOCUMENT
}

enum DegreeEquivalenceStatus {
  /// Diplôme rencontré, pas encore tranché.
  PENDING
  /// Équivalence retenue par EduLoc, réutilisable.
  VALIDATED
  /// Aucune équivalence reconnue.
  REJECTED
}

enum TutorDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TutorExperienceType {
  /// Expérience professionnelle sans lien direct avec l'enseignement.
  PROFESSIONAL
  /// Projet académique (recherche, mémoire, concours…).
  ACADEMIC
  /// Enseignement / soutien scolaire (répétiteur, animateur pédagogique, aide aux devoirs…).
  TEACHING
  /// Encadrement académique (monitorat, tutorat étudiant, jury, direction de travaux…).
  SUPERVISION
  VOLUNTEER
}

enum RelationshipType {
  SELF
  CHILD
  SPOUSE
  SIBLING
  PARENT
  RELATIVE
  OTHER
}

enum ObjectiveType {
  REMEDIAL
  ONGOING
  EXCELLENCE
}

enum DifficultyType {
  THEORETICAL
  PRACTICAL
  METHODOLOGICAL
  CONFIDENCE
  OTHER
}

enum TeachingFormat {
  ONLINE
  IN_PERSON
  BOTH
}

enum RhythmType {
  ONE_TIME
  OCCASIONAL
  REGULAR
  INTENSIVE
}

enum PlaceType {
  TUTOR_HOME
  BENEFICIARY_HOME
  PUBLIC_PLACE
  ONLINE
  /// Lieu symbolique « salles partenaires » : restreint une plage de disponibilité à ce mode (comme ONLINE).
  PARTNER_ROOM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  REFUSED
  CANCELLED
  IN_PROGRESS
  COMPLETED
}

enum BookingActor {
  REQUESTER
  TUTOR
  SYSTEM
  ADMIN
}

enum TeachingMode {
  ONLINE
  AT_HOME_BENEFICIARY
  AT_HOME_TUTOR
  PUBLIC_PLACE
  /// Salle d'un lieu partenaire : exige Booking.roomId (contrainte SQL bookings_room_mode).
  PARTNER_ROOM
}

enum ConversationStatus {
  OPEN
  READ_ONLY
  CLOSED
}

/// Pas de TEXT : la communication utilisateur est vocale (ADR-04).
enum MessageType {
  VOICE
  DOCUMENT
  SYSTEM
  CALL_EVENT
}

enum AttachmentKind {
  VOICE
  DOCUMENT
}

enum TranscriptStatus {
  NONE
  PENDING
  DONE
  FAILED
}

enum CallType {
  AUDIO
  VIDEO
}

enum CallStatus {
  RINGING
  ONGOING
  ENDED
  MISSED
  DECLINED
  CANCELLED
}

enum DevicePlatform {
  ANDROID
  IOS
  WEB
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_CONFIRMED
  BOOKING_REFUSED
  BOOKING_CANCELLED
  SESSION_STARTED
  SESSION_COMPLETED
  REVIEW_REQUEST
  TUTOR_APPLICATION
  TUTOR_APPLICATION_APPROVED
  TUTOR_APPLICATION_REJECTED
  TUTOR_SUSPENDED
  VOICE_MESSAGE
  DOCUMENT_MESSAGE
  INCOMING_CALL
  MISSED_CALL
  REMINDER
  SYSTEM
}

enum ConflictType {
  OVERLAPPING_BOOKINGS
  TUTOR_UNAVAILABLE
  AVAILABILITY_REMOVED
  OFFER_INACTIVE
  TUTOR_SUSPENDED
  /// Salle devenue indisponible (réservée, suspendue, dépubliée, fermée) entre la demande et l'acceptation.
  ROOM_UNAVAILABLE
}

enum ConflictStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ============================================================
// LIEUX PARTENAIRES (structures, salles, souscriptions)
// ============================================================

enum VenueType {
  TRAINING_CENTER
  COMPANY
  SCHOOL
  LIBRARY
  COWORKING
  ASSOCIATION
  COMMUNITY_CENTER
  OTHER
}

/// Dossier de structure. Le dossier de chaque salle a son propre statut (RoomStatus).
enum VenueStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  NEEDS_CORRECTION
  SUSPENDED
  /// Refusé par l'administrateur (motif obligatoire) : ni carte ni réservation ; une nouvelle soumission reste possible.
  REJECTED
  /// Désactivé par l'administrateur : retiré de la carte, séances déjà confirmées conservées.
  DISABLED
}

enum RoomStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  NEEDS_CORRECTION
  REJECTED
  SUSPENDED
}

enum RoomPublication {
  UNPUBLISHED
  PUBLISHED
  UNPUBLISHED_BY_ADMIN
}

/// Absence de ligne = NOT_SELECTED (exposé tel quel par l'API).
enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

enum VenueDocumentType {
  OWNERSHIP_PROOF
  BUSINESS_REGISTRATION
  MANAGER_IDENTITY
  INSURANCE
  OTHER
}

// ============================================================
// USER / DEMANDEUR
// ============================================================

model User {
  id        String @id @default(uuid())
  firstName String
  lastName  String
  email     String @unique
  password  String // hash argon2id

  phone    String?
  avatar   String?
  language String  @default("fr")
  timezone String  @default("Indian/Antananarivo")

  status UserStatus @default(PENDING_VERIFICATION)

  emailVerified              Boolean   @default(false)
  emailVerificationTokenHash String?   @unique
  emailVerificationExpiresAt DateTime?
  passwordResetTokenHash     String?   @unique
  passwordResetExpiresAt     DateTime?

  isAdmin Boolean @default(false)

  /// Alarme de cours (paramètre du compte) : rappel avant chaque séance confirmée du jour.
  lessonAlarmEnabled     Boolean @default(true)
  lessonAlarmLeadMinutes Int     @default(30)

  lastLoginAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  beneficiaries               Beneficiary[]
  bookings                    Booking[]            @relation("RequesterBookings")
  tutorProfile                TutorProfile?
  createdSubjects             Subject[]            @relation("SubjectCreator")
  sentMessages                Message[]            @relation("SentMessages")
  conversationsAsRequester    Conversation[]       @relation("RequesterConversations")
  reviews                     Review[]             @relation("RequesterReviews")
  refreshTokens               RefreshToken[]
  notifications               Notification[]
  deviceTokens                DeviceToken[]
  initiatedCalls              CallSession[]        @relation("InitiatedCalls")
  reviewedApplications        TutorApplication[]   @relation("ApplicationReviewer")
  bookingEvents               BookingEvent[]
  resolvedConflicts           Conflict[]           @relation("ConflictResolver")
  matchingSearches            MatchingSearch[]     @relation("RequesterMatchingSearches")
  validatedDegreeEquivalences DegreeEquivalence[]  @relation("DegreeEquivalenceValidator")
  validatedAcademicLevels     TutorProfile[]       @relation("AcademicLevelValidator")
  managedVenue                PartnerVenue?        @relation("VenueManager")
  reviewedVenues              PartnerVenue[]       @relation("VenueReviewer")
  reviewedRooms               Room[]               @relation("RoomReviewer")
  bookingHolds                BookingHold[]        @relation("RequesterHolds")
  roomReviews                 RoomReview[]         @relation("RoomReviewAuthor")
  roomReviewsHidden           RoomReview[]         @relation("RoomReviewHider")
  partnerStatusEvents         PartnerStatusEvent[]
  cvImports                   CvImport[]

  @@index([status])
  @@map("users")
}

// ============================================================
// AUTHENTICATION
// ============================================================

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique // SHA-256 du jeton opaque
  familyId  String // rotation : réutilisation détectée => révocation de la famille
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model DeviceToken {
  id         String         @id @default(uuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String         @unique
  platform   DevicePlatform
  lastSeenAt DateTime       @default(now())
  createdAt  DateTime       @default(now())

  @@index([userId])
  @@map("device_tokens")
}

// ============================================================
// BENEFICIARY
// ============================================================

model Beneficiary {
  id          String @id @default(uuid())
  requesterId String
  requester   User   @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  firstName    String
  lastName     String?
  birthDate    DateTime?
  relationship RelationshipType

  educationLevelId String?
  educationLevel   EducationLevel? @relation(fields: [educationLevelId], references: [id])

  objective       ObjectiveType?
  difficultyType  DifficultyType?
  preferredFormat TeachingFormat?
  preferredRhythm RhythmType?
  notes           String?         @db.Text

  /// Filière / parcours universitaire (ex. « Licence Informatique, parcours Génie logiciel »).
  studyProgram String?
  institution  String?

  // --- Préférences de recherche (jamais d'adresse exacte à l'inscription : seulement une zone) ---
  /// Quartier ou adresse approximative de référence (« Antananarivo – Anosy »).
  areaLabel           String?
  /// Rayon de recherche souhaité, en mètres (classement par proximité, jamais éligibilité).
  searchRadiusM       Int?
  /// Lieu préféré pour les séances (domicile, chez le tuteur, en ligne, salle partenaire…).
  preferredPlace      TeachingMode?
  /// Budget maximum par séance : les offres plus chères ne sont pas proposées.
  maxBudget           Decimal?      @db.Decimal(12, 2)
  /// Créneaux de disponibilité : [{ dayOfWeek, startTime, endTime }] (HH:mm).
  availabilityWindows Json?

  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  bookings         Booking[]
  matchingSearches MatchingSearch[]

  @@index([requesterId])
  @@index([educationLevelId])
  @@map("beneficiaries")
}

// ============================================================
// CATALOG
// ============================================================

model EducationLevel {
  id             String   @id @default(uuid())
  name           String
  category       String   @default("")
  displayOrder   Int      @default(0)
  isActive       Boolean  @default(true)
  /// Diplôme minimal pour enseigner ce niveau : BAC | LICENCE | MASTER | DOCTORAT.
  requiredDegree String   @default("BAC")
  /// Rang sur l'échelle académique ordonnée (1 = Primaire … 9 = Doctorat, cf. academic-scale.ts). Sert à l'éligibilité
  /// du matching ; distinct de displayOrder (affichage, réordonnable). Null = hors échelle (ex. « Formation pro »).
  academicRank   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  beneficiaries   Beneficiary[]
  tutorSubjects   TutorSubject[]
  offers          Offer[]
  /// Tuteurs dont le niveau académique validé est ce niveau.
  validatedTutors TutorProfile[]      @relation("TutorAcademicLevel")
  equivalences    DegreeEquivalence[]

  @@unique([name, category])
  @@index([isActive])
  @@map("education_levels")
}

enum TrackKind {
  SERIE
  MENTION
}

/// Filière académique : série du lycée (OSE, S, L, A1, A2, C, D) ou mention universitaire (nomenclature SISE).
/// Les mentions portent leur `domain` (Domaine mère), retrouvé côté serveur pour construire le texte d'embedding.
model AcademicTrack {
  id           String    @id @default(uuid())
  kind         TrackKind
  /// Série : « OSE », « A1 »… ; mention : slug stable (« INFORMATIQUE »).
  code         String
  name         String
  /// Mention : Domaine mère (« Sciences, Technologies et Santé »). Null pour une série.
  domain       String?
  /// Série : « NOUVEAU » (réforme) ou « ANCIEN » programme. Null pour une mention.
  programme    String?
  /// Série : niveau auquel elle appartient (« Première » ou « Terminale »). Null pour une mention.
  levelName    String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  offers Offer[]

  @@unique([kind, code])
  @@index([kind, isActive])
  @@map("academic_tracks")
}

model Subject {
  id              String   @id @default(uuid())
  name            String   @unique
  description     String?  @db.Text
  category        String?
  isActive        Boolean  @default(true)
  /// Catégories de niveaux où la matière s'enseigne (« Lycée », « Université »…). Vide = tous les niveaux.
  levelCategories String[] @default([])
  /// Synonymes et intitulés alternatifs (ex. « Algèbre 1 », « Algèbre linéaire L1 »). Inclus dans le chunk SUBJECT.
  aliases         String[] @default([])
  /// Codes des filières (AcademicTrack.code) pour lesquelles la matière est proposée : séries du lycée (Première/Terminale)
  /// ou mentions universitaires. Vide = toutes les filières. Sans effet au primaire et au collège.
  trackCodes      String[] @default([])
  /// Niveaux précis (EducationLevel.name) où la matière N'est PAS proposée dans ses catégories : ex. l'anglais n'arrive
  /// qu'en 8ème au primaire. Vide = proposée à tous les niveaux de ses catégories.
  excludedLevels  String[] @default([])
  /// false = compétence ajoutée librement par un tuteur : visible de lui seul jusqu'à l'approbation de son dossier.
  isVerified      Boolean  @default(true)
  createdById     String?
  createdBy       User?    @relation("SubjectCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tutorSubjects TutorSubject[]
  offers        Offer[]

  @@index([isActive])
  @@index([createdById])
  @@map("subjects")
}

// ============================================================
// TUTOR
// ============================================================

model TutorProfile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName         String?
  bio                 String?            @db.Text
  birthDate           DateTime?
  profilePhoto        String?
  experience          String?            @db.Text
  educationBackground String?            @db.Text
  /// Plus haut diplôme déclaré : BAC | LICENCE | MASTER | DOCTORAT | OTHER (détermine les niveaux enseignables).
  highestDegree       String?
  /// Si highestDegree = OTHER : équivalence appliquée par l'admin. À l'application, highestDegree reçoit
  /// equivalentDegree ; le lien garde la trace de la décision.
  degreeEquivalenceId String?
  degreeEquivalence   DegreeEquivalence? @relation(fields: [degreeEquivalenceId], references: [id], onDelete: SetNull)
  /// Intitulé exact du diplôme le plus élevé (ex. « Master Informatique, parcours Sécurité des systèmes »).
  degreeTitle         String?
  /// Domaine d'études (ex. « Informatique », « Économie », « Mathématiques »).
  fieldOfStudy        String?
  /// Spécialisation, parcours ou sujet de mémoire.
  specialization      String?
  /// Établissement ayant délivré le diplôme le plus élevé.
  degreeInstitution   String?
  /// Pays / système éducatif du diplôme (demandé quand highestDegree = OTHER, clé de DegreeEquivalence).
  degreeCountry       String?
  /// MALE | FEMALE : choisit l'avatar par défaut du tuteur (silhouette) tant qu'il n'a pas de photo.
  gender              String?

  /// Maintenu dans la même transaction que l'approbation / la suspension.
  isVisible   Boolean   @default(false)
  suspendedAt DateTime?

  rating       Float @default(0)
  reviewsCount Int   @default(0)

  /// Niveau académique VALIDÉ par un admin (seul celui-ci compte pour l'éligibilité universitaire). Null = non validé.
  /// Un tuteur qui prépare encore son diplôme est validé à son niveau en cours (L2, L3, M1…). Un expert professionnel
  /// sans doctorat est validé au niveau Doctorat avec une justification obligatoire (academicLevelNote).
  academicLevelId            String?
  academicLevel              EducationLevel? @relation("TutorAcademicLevel", fields: [academicLevelId], references: [id], onDelete: Restrict)
  academicLevelValidatedById String?
  academicLevelValidatedBy   User?           @relation("AcademicLevelValidator", fields: [academicLevelValidatedById], references: [id], onDelete: SetNull)
  academicLevelValidatedAt   DateTime?
  /// Motif de la décision (obligatoire pour un expert professionnel validé Doctorat sans doctorat).
  academicLevelNote          String?         @db.Text

  /// Dernière réindexation réussie de la recherche sémantique.
  searchIndexedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchChunks       TutorSearchChunk[]
  applications       TutorApplication[]
  experiences        TutorExperience[]
  introVideo         TutorIntroVideo?
  subjects           TutorSubject[]
  offers             Offer[]
  places             Place[]
  availabilities     Availability[]
  blockedPeriods     BlockedPeriod[]
  acceptedRooms      TutorRoom[]
  bookings           Booking[]          @relation("TutorBookings")
  bookingHolds       BookingHold[]
  /// Rayon (mètres) autour de sa position de référence dans lequel il accepte une salle partenaire ; null = illimité.
  partnerRoomRadiusM Int?
  /// Taux de commission propre au Tuteur : prévu au modèle, NON lu au MVP (taux global COMMISSION_RATE).
  commissionRate     Decimal?           @db.Decimal(5, 4)
  conversations      Conversation[]     @relation("TutorConversations")
  reviews            Review[]

  @@index([isVisible])
  @@index([academicLevelId])
  @@map("tutor_profiles")
}

model TutorApplication {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  status TutorApplicationStatus @default(DRAFT)

  submittedAt     DateTime?
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedBy      User?     @relation("ApplicationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  rejectionReason String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents TutorDocument[]

  @@index([tutorProfileId])
  @@index([status])
  @@map("tutor_applications")
}

model TutorExperience {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  type           TutorExperienceType
  title          String
  organization   String
  period         String
  description    String?             @db.Text
  /// Public encadré : catégories de niveaux (« Primaire », « Collège », « Lycée », « Université »).
  audience       String[]            @default([])
  /// Matières ou compétences enseignées, en texte libre.
  subjectsTaught String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([tutorProfileId, type])
  @@map("tutor_experiences")
}

model TutorIntroVideo {
  id             String       @id @default(uuid())
  tutorProfileId String       @unique
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  storagePath String   @unique
  mimeType    String
  sizeBytes   Int
  fileName    String?
  durationMs  Int?
  uploadedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("tutor_intro_videos")
}

model TutorDocument {
  id                 String           @id @default(uuid())
  tutorApplicationId String
  tutorApplication   TutorApplication @relation(fields: [tutorApplicationId], references: [id], onDelete: Cascade)

  type        TutorDocumentType
  storagePath String            @unique
  mimeType    String
  sizeBytes   Int
  fileName    String?

  status          TutorDocumentStatus @default(PENDING)
  rejectionReason String?             @db.Text

  /// Texte extrait (PDF texte ou OCR). Jamais exposé au Demandeur.
  extractedText    String?          @db.Text
  extractionStatus TranscriptStatus @default(NONE) // réutilise NONE | PENDING | DONE | FAILED
  /// Pré-contrôle automatique INDICATIF pour l'admin (type détecté, champs extraits, incohérences). Jamais décisionnel.
  autoCheck        Json?

  uploadedAt DateTime  @default(now())
  reviewedAt DateTime?

  @@index([tutorApplicationId])
  @@index([status])
  @@map("tutor_documents")
}

model TutorSubject {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  educationLevelId String
  educationLevel   EducationLevel @relation(fields: [educationLevelId], references: [id])

  competenceDescription String?  @db.Text
  createdAt             DateTime @default(now())

  @@unique([tutorProfileId, subjectId, educationLevelId])
  @@index([subjectId])
  @@index([educationLevelId])
  @@map("tutor_subjects")
}

model Offer {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id])

  educationLevelId String?
  educationLevel   EducationLevel? @relation(fields: [educationLevelId], references: [id])

  /// Série (Première/Terminale) ou mention (université) visée. Obligatoire à la création pour Première/Terminale.
  trackId String?
  track   AcademicTrack? @relation(fields: [trackId], references: [id])

  title           String
  description     String         @db.Text
  format          TeachingFormat @default(BOTH)
  durationMinutes Int            @default(60)
  /// Durées supplémentaires proposées (minutes), en plus de durationMinutes. Le prix est proportionnel à la durée.
  durationOptions Int[]          @default([])
  price           Decimal        @db.Decimal(12, 2)
  currency        String         @default("MGA")

  isActive          Boolean   @default(true)
  /// Désactivation par un admin (UC-G08) : le tuteur ne peut pas réactiver.
  disabledByAdminAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilities Availability[]
  bookings       Booking[]

  @@index([tutorProfileId])
  @@index([subjectId, educationLevelId])
  @@index([trackId])
  @@index([isActive])
  @@map("offers")
}

model Place {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  label     String
  address   String?
  latitude  Float?
  longitude Float?
  /// Rayon de déplacement en mètres (type BENEFICIARY_HOME)
  radius    Int?
  type      PlaceType
  isPrimary Boolean   @default(false)

  /// Colonne générée PostGIS (cf. 001_constraints.sql). Lecture via $queryRaw uniquement.
  location Unsupported("geography(Point, 4326)")?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  availabilities Availability[]
  bookings       Booking[]

  @@index([tutorProfileId])
  @@index([isActive])
  @@map("places")
}

/// Règle de disponibilité récurrente (pas un rendez-vous).
model Availability {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  placeId String?
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  offerId String?
  offer   Offer?  @relation(fields: [offerId], references: [id], onDelete: SetNull)

  /// 0 = dimanche ... 6 = samedi
  dayOfWeek Int
  /// "HH:mm", heure locale du fuseau `timezone`
  startTime String
  endTime   String
  timezone  String @default("Indian/Antananarivo")

  validFrom  DateTime?
  validUntil DateTime?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([tutorProfileId, isActive, dayOfWeek])
  @@index([placeId])
  @@index([offerId])
  @@map("availabilities")
}

/// Période bloquée ponctuelle (UC-E08 « bloquer une période »).
model BlockedPeriod {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime
  reason         String?
  createdAt      DateTime     @default(now())

  @@index([tutorProfileId, startAt, endAt])
  @@map("blocked_periods")
}

// ============================================================
// LIEUX PARTENAIRES
// ============================================================

/// Structure partenaire. Son Gestionnaire (managerId) n'a pas de rôle global : posséder une structure suffit.
model PartnerVenue {
  id        String @id @default(uuid())
  managerId String @unique
  manager   User   @relation("VenueManager", fields: [managerId], references: [id], onDelete: Cascade)

  name               String
  type               VenueType @default(OTHER)
  description        String?   @db.Text
  legalName          String?
  registrationNumber String?
  /// NIF et STAT : facultatifs à l'inscription, obligatoires pour être « Vérifié ». Jamais dans une API publique.
  nif                String?
  stat               String?
  contactPhone       String?
  contactEmail       String?

  status       VenueStatus @default(DRAFT)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?       @relation("VenueReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  /// Dernière décision de l'administrateur (corrections demandées, motif de suspension…).
  reviewNote   String?     @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents     VenueDocument[]
  rooms         Room[]
  subscriptions VenueSubscription[]
  statusEvents  PartnerStatusEvent[]

  @@index([status])
  @@map("partner_venues")
}

model VenueDocument {
  id      String            @id @default(uuid())
  venueId String
  venue   PartnerVenue      @relation(fields: [venueId], references: [id], onDelete: Cascade)
  type    VenueDocumentType

  storagePath String   @unique
  mimeType    String
  sizeBytes   Int
  fileName    String?
  uploadedAt  DateTime @default(now())

  @@index([venueId])
  @@map("venue_documents")
}

model Room {
  id      String       @id @default(uuid())
  venueId String
  venue   PartnerVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)

  name        String
  description String? @db.Text

  // --- Position EXACTE : jamais dans une API publique ni avant la confirmation de la séance ---
  addressLine        String?
  city               String?
  latitude           Float?
  longitude          Float?
  accessInstructions String?                                @db.Text
  /// Colonne générée PostGIS (cf. migration). Lecture via $queryRaw uniquement.
  location           Unsupported("geography(Point, 4326)")?

  // --- Affichage public ---
  /// Zone approximative (quartier, ville) : seul repère géographique de la fiche publique.
  zoneLabel          String?
  capacity           Int      @default(1)
  equipment          String[] @default([])
  accessibility      String[] @default([])
  /// Règles particulières d'accueil des mineurs à confirmer (spec §13.8) : refus par défaut.
  welcomesMinors     Boolean  @default(false)
  pricePerHour       Decimal? @db.Decimal(12, 2)
  currency           String   @default("MGA")
  rules              String?  @db.Text
  cancellationPolicy String?  @db.Text
  timezone           String   @default("Indian/Antananarivo")

  status       RoomStatus      @default(DRAFT)
  publication  RoomPublication @default(UNPUBLISHED)
  publishedAt  DateTime?
  /// Fermeture temporaire décidée par le Gestionnaire (la salle reste validée).
  isActive     Boolean         @default(true)
  submittedAt  DateTime?
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?           @relation("RoomReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNote   String?         @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  photos         RoomPhoto[]
  availabilities RoomAvailability[]
  blockedPeriods RoomBlockedPeriod[]
  tutorRooms     TutorRoom[]
  bookingHolds   BookingHold[]
  /// Moyenne des notes « expérience globale » des avis visibles, et leur nombre (recalculés à chaque avis / masquage).
  rating         Float                @default(0)
  reviewsCount   Int                  @default(0)
  roomReviews    RoomReview[]
  /// Taux de commission propre à la salle : prévu au modèle, NON lu au MVP.
  commissionRate Decimal?             @db.Decimal(5, 4)
  bookings       Booking[]
  statusEvents   PartnerStatusEvent[]

  @@index([venueId])
  @@index([status, publication, isActive])
  @@map("rooms")
}

model RoomPhoto {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  storagePath String   @unique
  mimeType    String
  sizeBytes   Int
  position    Int      @default(0)
  uploadedAt  DateTime @default(now())

  @@index([roomId, position])
  @@map("room_photos")
}

/// Plage d'ouverture récurrente d'une salle (même forme qu'Availability, fuseau de la salle).
model RoomAvailability {
  id     String @id @default(uuid())
  roomId String
  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// 0 = dimanche ... 6 = samedi
  dayOfWeek  Int
  startTime  String
  endTime    String
  validFrom  DateTime?
  validUntil DateTime?
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([roomId, isActive, dayOfWeek])
  @@map("room_availabilities")
}

model RoomBlockedPeriod {
  id      String   @id @default(uuid())
  roomId  String
  room    Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  startAt DateTime
  endAt   DateTime
  reason  String?

  createdAt DateTime @default(now())

  @@index([roomId, startAt, endAt])
  @@map("room_blocked_periods")
}

/// Le Tuteur accepte d'intervenir dans cette salle. Ne réserve JAMAIS la salle (spec §3.1).
model TutorRoom {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  roomId         String
  room           Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  isActive       Boolean      @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tutorProfileId, roomId])
  @@index([roomId])
  @@map("tutor_rooms")
}

/// Catalogue des offres commerciales : prix et durées sont des données, pas du code (spec §8.4, points à confirmer).
model PartnerPlan {
  id           String  @id @default(uuid())
  code         String  @unique
  name         String
  description  String? @db.Text
  priceAmount  Decimal @db.Decimal(12, 2)
  currency     String  @default("MGA")
  durationDays Int
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions VenueSubscription[]

  @@map("partner_plans")
}

/// Souscription rattachée à la STRUCTURE (couvre ses salles). Au plus une PENDING/ACTIVE par structure.
model VenueSubscription {
  id      String       @id @default(uuid())
  venueId String
  venue   PartnerVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  planId  String
  plan    PartnerPlan  @relation(fields: [planId], references: [id])

  status      SubscriptionStatus @default(PENDING)
  startsAt    DateTime?
  endsAt      DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([venueId, status])
  @@map("venue_subscriptions")
}

/// Historique des changements de statut d'une structure, d'une salle, d'une publication ou d'une souscription.
model PartnerStatusEvent {
  id      String       @id @default(uuid())
  venueId String
  venue   PartnerVenue @relation(fields: [venueId], references: [id], onDelete: Cascade)
  roomId  String?
  room    Room?        @relation(fields: [roomId], references: [id], onDelete: Cascade)

  /// VENUE | ROOM | PUBLICATION | SUBSCRIPTION
  scope       String
  fromStatus  String?
  toStatus    String
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([venueId, createdAt])
  @@index([roomId, createdAt])
  @@map("partner_status_events")
}

// ============================================================
// BOOKING
// ============================================================

model Booking {
  id String @id @default(uuid())

  requesterId String
  requester   User   @relation("RequesterBookings", fields: [requesterId], references: [id])

  beneficiaryId String
  beneficiary   Beneficiary @relation(fields: [beneficiaryId], references: [id])

  tutorProfileId String
  tutorProfile   TutorProfile @relation("TutorBookings", fields: [tutorProfileId], references: [id])

  offerId String
  offer   Offer  @relation(fields: [offerId], references: [id])

  availabilityId String?
  availability   Availability? @relation(fields: [availabilityId], references: [id], onDelete: SetNull)

  placeId String?
  place   Place?  @relation(fields: [placeId], references: [id], onDelete: SetNull)

  /// Salle partenaire (teachingMode = PARTNER_ROOM). La salle n'est réservée qu'à la confirmation (CONFIRMED / IN_PROGRESS) :
  /// l'exclusion SQL bookings_room_no_overlap la rend inchevauchable, dans la même ligne que la séance.
  roomId String?
  room   Room?   @relation(fields: [roomId], references: [id], onDelete: Restrict)

  startAt DateTime
  endAt   DateTime
  status  BookingStatus @default(PENDING)

  teachingMode TeachingMode

  // --- Snapshot au moment de la réservation ---
  price           Decimal @db.Decimal(12, 2)
  currency        String  @default("MGA")
  offerTitle      String
  locationLabel   String?
  locationAddress String?
  latitude        Float?
  longitude       Float?
  requesterNote   String? @db.Text

  // --- Salle partenaire ---
  /// Besoins de la séance, revérifiés à l'acceptation.
  participantsCount Int      @default(1)
  requiredEquipment String[] @default([])
  /// Tarif de la salle pour la durée = part du partenaire (le paiement en ligne est hors périmètre).
  roomFee           Decimal? @db.Decimal(12, 2)

  // --- Décomposition du prix (figée à la réservation ; `price` reste le tarif du Tuteur) ---
  /// Forfait de déplacement (grille commune), dû au Tuteur pour un cours chez le Bénéficiaire.
  travelFee              Decimal @default(0) @db.Decimal(12, 2)
  /// Distance à vol d'oiseau tuteur ↔ adresse approximative, arrondie au mètre (null hors cours à domicile).
  travelDistanceM        Int?
  /// Frais de service EduLoc = commission sur le tarif du Tuteur, payée EN PLUS par le Demandeur.
  serviceFee             Decimal @default(0) @db.Decimal(12, 2)
  serviceFeeRate         Decimal @default(0) @db.Decimal(5, 4)
  /// Montant unique payé par le Demandeur : price + travelFee + roomFee + serviceFee.
  totalAmount            Decimal @default(0) @db.Decimal(12, 2)
  /// Copié à la confirmation seulement : jamais renvoyé avant (locationAddress, latitude et longitude non plus).
  roomAccessInstructions String? @db.Text

  // --- Séance ---
  startOtpCipher String? // AES-256-GCM
  otpAttempts    Int       @default(0)
  otpExpiresAt   DateTime?
  startedAt      DateTime?
  completedAt    DateTime?

  // --- Rappels de séance (un par partie, jamais deux fois) ---
  requesterRemindedAt DateTime?
  tutorRemindedAt     DateTime?

  // --- Annulation / refus ---
  cancelledBy        BookingActor?
  cancellationReason String?       @db.Text
  refusalReason      String?       @db.Text

  /// Recherche d'où vient la réservation (mesure de conversion du matching).
  matchingSearchId String?
  matchingSearch   MatchingSearch? @relation(fields: [matchingSearchId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversations Conversation[]
  calls         CallSession[]
  review        Review?
  events        BookingEvent[]
  conflicts     Conflict[]
  hold          BookingHold?
  roomReviews   RoomReview[]

  @@index([requesterId, startAt])
  @@index([beneficiaryId])
  @@index([tutorProfileId, status, startAt])
  @@index([tutorProfileId, startAt, endAt])
  @@index([offerId])
  @@index([availabilityId])
  @@index([status, startAt])
  @@index([matchingSearchId])
  @@index([roomId, status, startAt])
  @@map("bookings")
}

/// Blocage temporaire (15 min) du créneau du Tuteur et de la salle pendant que le Demandeur finalise sa réservation.
/// Géré côté serveur : un blocage ACTIVE et non expiré compte comme occupé pour les AUTRES demandeurs.
model BookingHold {
  id String @id @default(uuid())

  requesterId String
  requester   User   @relation("RequesterHolds", fields: [requesterId], references: [id], onDelete: Cascade)

  beneficiaryId  String
  offerId        String
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)
  roomId         String?
  room           Room?        @relation(fields: [roomId], references: [id], onDelete: Cascade)

  teachingMode    TeachingMode
  startAt         DateTime
  endAt           DateTime
  durationMinutes Int
  /// Total annoncé au Demandeur : à la finalisation, un total différent annule le blocage (PRICE_CHANGED).
  totalAmount     Decimal      @db.Decimal(12, 2)

  status    HoldStatus @default(ACTIVE)
  expiresAt DateTime
  bookingId String?    @unique
  booking   Booking?   @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([tutorProfileId, status, expiresAt])
  @@index([roomId, status, expiresAt])
  @@index([requesterId, status])
  @@map("booking_holds")
}

enum HoldStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

/// Journal d'audit des transitions (machine d'états).
model BookingEvent {
  id          String         @id @default(uuid())
  bookingId   String
  booking     Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  fromStatus  BookingStatus?
  toStatus    BookingStatus
  actor       BookingActor
  actorUserId String?
  actorUser   User?          @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  reason      String?
  createdAt   DateTime       @default(now())

  @@index([bookingId, createdAt])
  @@map("booking_events")
}

// ============================================================
// COMMUNICATION (vocal, documents, appels LiveKit)
// ============================================================

/// Une conversation par paire demandeur / tuteur (ADR-12).
model Conversation {
  id String @id @default(uuid())

  requesterId String
  requester   User   @relation("RequesterConversations", fields: [requesterId], references: [id], onDelete: Cascade)

  tutorProfileId String
  tutorProfile   TutorProfile @relation("TutorConversations", fields: [tutorProfileId], references: [id], onDelete: Cascade)

  /// Réservation de contexte la plus récente
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  status ConversationStatus @default(OPEN)

  lastMessageType     MessageType?
  lastMessagePreview  String?
  lastMessageAt       DateTime?
  requesterLastReadAt DateTime?
  tutorLastReadAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]
  calls    CallSession[]

  @@unique([requesterId, tutorProfileId])
  @@index([requesterId, lastMessageAt])
  @@index([tutorProfileId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  /// null pour SYSTEM / CALL_EVENT
  senderId String?
  sender   User?   @relation("SentMessages", fields: [senderId], references: [id], onDelete: SetNull)

  type            MessageType
  clientMessageId String      @default(uuid())
  systemText      String?     @db.Text

  replyToId String?
  replyTo   Message?  @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies   Message[] @relation("Replies")

  callSessionId String?      @unique
  callSession   CallSession? @relation(fields: [callSessionId], references: [id], onDelete: SetNull)

  listenedAt DateTime?
  deletedAt  DateTime?
  createdAt  DateTime  @default(now())

  attachment MessageAttachment?

  @@unique([conversationId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
  @@map("messages")
}

model MessageAttachment {
  id        String  @id @default(uuid())
  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  kind        AttachmentKind
  bucket      String
  storagePath String         @unique
  mimeType    String
  sizeBytes   Int
  fileName    String?

  // VOICE
  durationMs Int?
  waveform   Json?

  // Transcription (décision ouverte n°6)
  transcriptStatus TranscriptStatus @default(NONE)
  transcript       String?          @db.Text

  createdAt DateTime @default(now())

  @@map("message_attachments")
}

model CallSession {
  id String @id @default(uuid())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  /// Nom de la room LiveKit (unique)
  roomName String     @unique
  type     CallType
  status   CallStatus @default(RINGING)

  initiatedById String
  initiatedBy   User   @relation("InitiatedCalls", fields: [initiatedById], references: [id])

  ringingUntil DateTime
  startedAt    DateTime?
  endedAt      DateTime?
  durationSec  Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  message Message?

  @@index([conversationId, createdAt])
  @@index([bookingId])
  @@index([status, ringingUntil])
  @@map("call_sessions")
}

// ============================================================
// REVIEW
// ============================================================

model Review {
  id String @id @default(uuid())

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id])

  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id])

  /// Auteur. Décision ouverte n°5 : ajouter beneficiaryId si le bénéficiaire évalue.
  requesterId String
  requester   User   @relation("RequesterReviews", fields: [requesterId], references: [id])

  rating        Int
  text          String?   @db.Text
  officialReply String?   @db.Text
  repliedAt     DateTime?
  hiddenAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorProfileId, createdAt])
  @@index([requesterId])
  @@map("reviews")
}

/// Avis sur une salle partenaire : lié à une séance TERMINÉE tenue dans cette salle, écrit par une personne qui y a assisté
/// (le Demandeur ou le Tuteur de la séance). Un seul avis par séance et par auteur.
model RoomReview {
  id String @id @default(uuid())

  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  roomId    String
  room      Room    @relation(fields: [roomId], references: [id], onDelete: Cascade)
  authorId  String
  author    User    @relation("RoomReviewAuthor", fields: [authorId], references: [id])

  // Critères, de 1 à 5.
  cleanliness   Int
  safety        Int
  accessibility Int
  equipment     Int
  /// Respect des horaires (ouverture, accueil, disponibilité de la salle à l'heure).
  punctuality   Int
  overall       Int
  comment       String? @db.Text

  /// Réponse du partenaire : une seule, non modifiable.
  partnerReply String?   @db.Text
  repliedAt    DateTime?

  /// Masqué par l'administrateur (avis frauduleux, offensant ou contenant des informations privées) : motif obligatoire.
  hiddenAt     DateTime?
  hiddenReason String?   @db.Text
  hiddenById   String?
  hiddenBy     User?     @relation("RoomReviewHider", fields: [hiddenById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([bookingId, authorId])
  @@index([roomId, createdAt])
  @@map("room_reviews")
}

// ============================================================
// RECHERCHE SÉMANTIQUE (eduloc-recherche-semantique.md, §3.2)
// ============================================================

/// Table administrable des équivalences de diplômes hors catégories principales (spec §13, décision 2).
/// Une équivalence validée une fois est réutilisée pour les tuteurs suivants qui déclarent le même diplôme.
model DegreeEquivalence {
  id                String                  @id @default(uuid())
  /// Intitulé du diplôme tel que déclaré (ex. « Diplôme d'ingénieur en informatique », « DUT Génie électrique »).
  degreeTitle       String
  /// Pays ou système éducatif (ex. « Madagascar », « France », « Maurice »).
  country           String
  /// Spécialité, si elle conditionne l'équivalence ("" sinon : pas de null, pour que l'unicité fonctionne).
  specialty         String                  @default("")
  /// Niveau retenu par EduLoc : BAC | LICENCE | MASTER | DOCTORAT. Null si REJECTED.
  equivalentDegree  String?
  /// Niveau académique retenu (échelle E2). Alimente TutorProfile.academicLevelId à l'application. Null si REJECTED.
  equivalentLevelId String?
  equivalentLevel   EducationLevel?         @relation(fields: [equivalentLevelId], references: [id], onDelete: Restrict)
  status            DegreeEquivalenceStatus @default(PENDING)
  notes             String?                 @db.Text
  validatedById     String?
  validatedBy       User?                   @relation("DegreeEquivalenceValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt       DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  tutorProfiles TutorProfile[]

  @@unique([degreeTitle, country, specialty])
  @@index([status])
  @@map("degree_equivalences")
}

/// Unité de texte indexée pour la recherche sémantique d'un tuteur.
model TutorSearchChunk {
  id             String       @id @default(uuid())
  tutorProfileId String
  tutorProfile   TutorProfile @relation(fields: [tutorProfileId], references: [id], onDelete: Cascade)

  sourceType SearchChunkSource
  /// Id de la source : tutorProfileId (PROFILE), subjectId (SUBJECT), TutorExperience.id, Offer.id, TutorDocument.id
  sourceId   String
  chunkIndex Int               @default(0)

  /// Libellé affichable pour expliquer un match. Jamais d'extrait de document.
  label       String
  /// Texte exact envoyé au modèle (préfixe inclus), données personnelles retirées.
  content     String  @db.Text
  /// sha256(embeddingModel + EMBEDDING_DIM + content) : ne recalculer que si ça change.
  contentHash String
  /// Dénormalisé pour le bonus « matière déclarée » (SUBJECT et OFFER).
  subjectId   String?

  /// Lecture / écriture via SQL brut uniquement.
  embedding      Unsupported("vector(768)")?
  embeddingModel String
  embeddedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tutorProfileId, sourceType, sourceId, chunkIndex])
  @@index([tutorProfileId])
  @@map("tutor_search_chunks")
}

/// Journal des recherches : sert à évaluer et calibrer le matching.
model MatchingSearch {
  id            String       @id @default(uuid())
  requesterId   String
  requester     User         @relation("RequesterMatchingSearches", fields: [requesterId], references: [id], onDelete: Cascade)
  beneficiaryId String?
  beneficiary   Beneficiary? @relation(fields: [beneficiaryId], references: [id], onDelete: SetNull)

  educationLevelId String
  subjectId        String?
  subjectText      String?
  needDescription  String          @db.Text
  objective        ObjectiveType?
  format           TeachingFormat?

  candidateCount Int
  /// [{ tutorProfileId, rank, finalScore, bestSim, bestSource }]
  results        Json
  embeddingModel String
  durationMs     Int?
  createdAt      DateTime @default(now())

  bookings Booking[]

  @@index([requesterId, createdAt])
  @@map("matching_searches")
}

// ============================================================
// NOTIFICATIONS & OUTBOX
// ============================================================

model Notification {
  id      String           @id @default(uuid())
  userId  String
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title   String
  message String           @db.Text
  type    NotificationType
  data    Json?
  isRead  Boolean          @default(false)
  linkUrl String?

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

/// Transactional outbox : écrite dans la transaction métier, publiée par le relay.
model OutboxEvent {
  id            String    @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  recipientIds  String[]
  payload       Json
  pushTitle     String?
  pushBody      String?
  /// Clés Redis à invalider après publication
  cacheKeys     String[]
  attempts      Int       @default(0)
  lockedUntil   DateTime?
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime  @default(now())

  @@index([processedAt, createdAt])
  @@map("outbox_events")
}

// ============================================================
// ADMIN — CONFLITS (UC-G10, G11)
// ============================================================

model Conflict {
  id        String         @id @default(uuid())
  type      ConflictType
  status    ConflictStatus @default(OPEN)
  bookingId String
  booking   Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  details   Json?

  resolvedById String?
  resolvedBy   User?     @relation("ConflictResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolution   String?   @db.Text
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bookingId, type])
  @@index([status, createdAt])
  @@map("conflicts")
}

enum CvImportStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// Import de CV pour pré-remplir le dossier tuteur : fichier original, texte extrait (PaddleOCR / PDF), JSON proposé
/// par le LLM. Le JSON n'est jamais la vérité : le tuteur relit et confirme dans le formulaire.
model CvImport {
  id     String @id @default(uuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status        CvImportStatus @default(PENDING)
  fileName      String?
  mimeType      String
  sizeBytes     Int
  storagePath   String         @unique
  /// Texte lu dans le CV (nettoyé). Reste côté serveur.
  extractedText String?        @db.Text
  /// Résultat normalisé et validé (schéma strict, champs null quand absents, confiance par champ).
  result        Json?
  /// Code stable de l'échec (UNREADABLE, OCR_UNAVAILABLE, LLM_UNAVAILABLE, INVALID_OUTPUT) : l'app propose la saisie manuelle.
  errorCode     String?
  ocrEngine     String?
  model         String?
  durationMs    Int?
  /// Étape en cours (READING, ANALYZING, MATCHING) : affichée dans l'app pendant l'analyse.
  stage         String?
  /// SHA-256 du fichier : un même CV ré-importé réutilise le texte et les entrées déjà trouvées.
  fileHash      String?
  /// Numéros de ligne désignés par le modèle (cache) ; les règles de lecture sont rejouées à chaque import.
  llmEntries    Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([userId, fileHash])
  @@map("cv_imports")
}
