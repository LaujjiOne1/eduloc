{
  "expo": {
    "name": "edUloc",
    "slug": "edUloc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "eduloc",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "EduLoc utilise la caméra pour les appels vidéo avec votre tuteur ou votre élève.",
        "NSMicrophoneUsageDescription": "EduLoc utilise le micro pour enregistrer vos messages vocaux et passer des appels.",
        "UIBackgroundModes": [
          "audio",
          "voip"
        ]
      },
      "bundleIdentifier": "mg.eduloc.app"
    },
    "android": {
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "mg.eduloc.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@maplibre/maplibre-react-native",
      "@livekit/react-native-expo-plugin",
      [
        "expo-image-picker",
        {
          "photosPermission": "EduLoc accède à votre photothèque pour sélectionner votre vidéo de présentation.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "EduLoc utilise le micro pour enregistrer vos messages vocaux et passer des appels."
        }
      ],
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/ringtone.wav"
          ]
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "EduLoc utilise votre position pour trouver des tuteurs près de chez vous."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "fr",
              "en",
              "mg"
            ],
            "android": [
              "fr",
              "en",
              "mg"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "fr": "./locales/fr.json",
      "en": "./locales/en.json",
      "mg": "./locales/mg.json"
    }
  }
}
